<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.SyncService" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#0F172A</item>
        <item name="colorPrimaryVariant">#1E293B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Background colors -->
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar" tools:ignore="NewApi">false</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background of the splash screen -->
        <item name="windowSplashScreenBackground">#0F172A</item>
        <!-- Icon that will be displayed in the center -->
        <item name="windowSplashScreenAnimatedIcon">@android:drawable/ic_menu_preferences</item>
        <!-- Post-splash screen theme -->
        <item name="postSplashScreenTheme">@style/Theme.SyncService</item>
    </style>
</resources>
